    "unconnected-(U22-CC-Pad3)" "unconnected-(U23-CC-Pad3)" "unconnected-(U24-CC-Pad3)" "unconnected-(U25-CC-Pad3)" "unconnected-(U26-CC-Pad3)" "unconnected-(U42-CC-Pad3)" "unconnected-(U51-CC-Pad3)" "unconnected-(U52-CC-Pad3)"
    "unconnected-(U53-CC-Pad3)" "unconnected-(U54-CC-Pad3)" "unconnected-(U55-CC-Pad3)" "unconnected-(U56-CC-Pad3)" "unconnected-(U57-CC-Pad3)" "/digit_max_1/DIG_5" "/digit_max_1/DIG_4" "/digit_max_1/SEG_D"
    "Net-(U2-DOUT)" "/digit_max_1/SEG_A" "/digit_max_1/SEG_C" "/digit_max_1/DIG_3" "/digit_max_1/DIG_1" "/digit_max_1/SEG_E" "/digit_max_1/SEG_G" "/digit_max_1/SEG_B"
    "/digit_max_1/SEG_DP" "/digit_max_1/DIG_2" "/digit_max_1/DIG_6" "Net-(U2-DIN)" "/digit_max_1/SEG_F" "/digit_max_1/DIG_0" "/digit_max_1/DIG_7" "Net-(U4-DIN)"
    "/digit_max_3/DIG_1" "/digit_max_3/SEG_G" "/digit_max_3/SEG_DP" "/digit_max_3/DIG_2" "/digit_max_3/DIG_6" "/digit_max_3/SEG_D" "/digit_max_3/DIG_0" "/digit_max_3/SEG_B"
    "Net-(U6-DIN)" "/digit_max_3/SEG_F" "/digit_max_3/DIG_4" "/digit_max_3/DIG_3" "/digit_max_3/SEG_C" "/digit_max_3/SEG_A" "/digit_max_3/DIG_7" "/digit_max_3/SEG_E"
    "/digit_max_3/DIG_5" "/digit_max_5/DIG_2" "/digit_max_5/SEG_DP" "/digit_max_5/DIG_5" "/digit_max_5/DIG_6" "/digit_max_5/DIG_0" "/digit_max_5/SEG_F" "/digit_max_5/DIG_4"
    "/digit_max_5/SEG_B" "/digit_max_5/SEG_E" "/digit_max_5/SEG_D" "/digit_max_5/DIG_3" "/digit_max_5/SEG_G" "/digit_max_5/DIG_7" "/digit_max_5/SEG_C" "/digit_max_5/DIG_1"
    "/digit_max_5/SEG_A" "unconnected-(U11-CC-Pad3)" "unconnected-(U12-CC-Pad3)" "unconnected-(U13-CC-Pad3)" "unconnected-(U14-CC-Pad3)" "unconnected-(U15-CC-Pad3)" "unconnected-(U16-CC-Pad3)" "unconnected-(U17-CC-Pad3)"
    "unconnected-(U18-CC-Pad3)" "unconnected-(U27-CC-Pad3)" "unconnected-(U28-CC-Pad3)" "unconnected-(U29-CC-Pad3)" "unconnected-(U30-CC-Pad3)" "unconnected-(U31-CC-Pad3)" "unconnected-(U32-CC-Pad3)" "unconnected-(U33-CC-Pad3)"
    "unconnected-(U43-CC-Pad3)" "unconnected-(U44-CC-Pad3)" "unconnected-(U45-CC-Pad3)" "unconnected-(U46-CC-Pad3)" "unconnected-(U47-CC-Pad3)" "unconnected-(U48-CC-Pad3)" "unconnected-(U49-CC-Pad3)" "unconnected-(U50-CC-Pad3)"
    "unconnected-(U3-DOUT-Pad24)" "/digit_max_7/SEG_A" "/digit_max_7/SEG_E" "/digit_max_7/SEG_F" "/digit_max_7/DIG_0" "unconnected-(U58-CC-Pad3)" "/digit_max_7/SEG_DP" "/digit_max_7/SEG_B"
    "/digit_max_7/SEG_G" "/digit_max_7/SEG_D" "/digit_max_7/SEG_C" "/digit_max_7/DIG_1" "unconnected-(U59-CC-Pad3)"
    (clearance_class "kicad_default")
    (via_rule "kicad_default")
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)